# Copia este archivo a terraform.tfvars y ajusta los valores según necesites.
# terraform.tfvars NO debe subirse al repo si contiene datos sensibles
# (en este caso son solo nombres, pero se mantiene la buena práctica).

project_name      = "codeai-tf"
aws_region        = "us-east-1"
bedrock_model_id  = "amazon.nova-lite-v1:0"
enable_cloudfront = false
